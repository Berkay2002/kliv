# Next.js Environment Variables
# Copy this file to .env.local and fill in your actual values

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Kliv Idrottsförening"

# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google Maps Embed API (for embedded maps)
GOOGLE_MAPS_EMBED_API_KEY=your_google_maps_embed_api_key_here

# Google Calendar API Configuration
GOOGLE_CALENDAR_API_KEY=your_google_calendar_api_key_here


# Contact Form Configuration
# Email service for contact form submissions
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Development/Production Flags
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
ENABLE_GOOGLE_MAPS=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Organization Information
NEXT_PUBLIC_ORG_NAME="Kliv Idrottsförening"
NEXT_PUBLIC_ORG_NUMBER="802509-8842"
NEXT_PUBLIC_ORG_ADDRESS="Tomtbergavägen 370A, 145 71 Norsborg"
NEXT_PUBLIC_ORG_EMAIL="info@kliv.se"
NEXT_PUBLIC_ORG_PHONE="+46 123 456 789"

# Team Contact Information
NEXT_PUBLIC_CHAIRMAN_EMAIL="muhammet@klivif.se"
NEXT_PUBLIC_MEMBERSHIP_EMAIL="Maria@kliv.se"
NEXT_PUBLIC_ACTIVITIES_EMAIL="Eldar@klivif.se"
NEXT_PUBLIC_PR_EMAIL="Binel@klivif.se"
NEXT_PUBLIC_PR2_EMAIL="Leah@klivif.se"

# Google Calendar Integration
# Calendar ID from Google Calendar settings
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Google Service Account Configuration
# Get from Google Cloud Console > IAM & Admin > Service Accounts
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...your private key...\n-----END PRIVATE KEY-----\n"

# Webhook URL for Google Calendar notifications
# Will be auto-generated if not provided: ${NEXT_PUBLIC_SITE_URL}/api/google-calendar-webhook
GOOGLE_WEBHOOK_URL=https://your-domain.vercel.app/api/google-calendar-webhook

# Redis Configuration (for subscriber storage)
# Local development: redis://localhost:6379
# Production: Use Redis cloud service (Upstash, Railway, etc.)
REDIS_URL=redis://localhost:6379
